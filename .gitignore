# Private local folders — never pushed to GitHub
# Convention: any folder ending in _local/ is gitignored.
# Today this covers docs_local/ (working notes) and research_local/ (papers, references).
**/*_local/

# Data files — download instructions in README
data/raw/
data/processed/
*.csv
*.txt
*.h5

# Exception: Render needs pip dependencies for deployment
!requirements.txt

# Exception: ship the demo CSV so the upload workflow is testable end-to-end
!frontend/sample_engine.csv

# Exception: runtime.txt pins the Python version for Render deployment
!runtime.txt

# Jupyter artifacts
.ipynb_checkpoints/
*.ipynb_checkpoints

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Environment
.env
.venv/
venv/
env/

# OS
.DS_Store
Thumbs.db

# Model artifacts — commit the deployable XGBoost artifact so Render can serve predictions.
# To regenerate: run notebooks/03_modeling.ipynb.
*.pkl
models/*.pkl
models/*
!models/.gitkeep
!models/xgb_rul.joblib
